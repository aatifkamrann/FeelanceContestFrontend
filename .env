# Copy to .env — docker compose reads it automatically.

POSTGRES_PASSWORD=winnersportal
MINIO_ROOT_USER=winnersportal
MINIO_ROOT_PASSWORD=winnersportal
MEILI_MASTER_KEY=dev-master-key-change-me

# --- first run -----------------------------------------------------------
# true = bootstrap without the wizard (demo path); false = wizard at /setup
SETUP_AUTO=true
# Pin the wizard token instead of the generated one in the API logs:
SETUP_TOKEN=
# Used only when SETUP_AUTO=true (defaults: admin@winnersportal.local / winners-demo):
SETUP_ADMIN_EMAIL=admin@freelancecontest.local
SETUP_ADMIN_PASSWORD=freelance-contest

# --- dev webhook tunnel (profile: dev) -----------------------------------
